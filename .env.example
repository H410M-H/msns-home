# Copy to .env.local and fill in. Never commit real values.
# The schema lives in src/env.js; keep both in sync.

# Cloudflare R2 (S3-compatible) bucket shared with the LMS.
# S3_* names are also accepted (S3_ENDPOINT, S3_ACCESS_KEY_ID, ...).
AWS_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
AWS_DEFAULT_REGION="auto"
AWS_S3_BUCKET_NAME="msns"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# SMTP for online admission emails. In production the admission form
# returns 503 if these are missing, so applications are never lost silently.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Bearer secret for /api/gallery/upload and DELETE /api/gallery/* (16+ chars).
GALLERY_API_SECRET=""

# Google Places API key for home page reviews.
GOOGLE_MAPS_API_KEY=""
